// use prisma-8

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

model User {
  id            String         @id @default(uuid())
  email         String?
  name          String?
  avatar        String?
  emailVerified Boolean        @default(false)

  oauthAccounts OAuthAccount[]

  createdAt     DateTime       @default(now())
}

model OAuthAccount {
  id                String       @id @default(uuid())
  provider          OAuthProvider
  providerAccountId String

  userId            String
  user              User         @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  createdAt         DateTime     @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}